<?xml version='1.0' encoding='utf-8'?>
<widget id="com.tughneghaq.game" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Tughneghaq</name>
    <description>Word guess game</description>
    <author email="dev.wwelisa@gmail.com" href="">wwelisa</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
	    <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="35" />
        <preference name="android-compileSdkVersion" value="35" />
        <icon src="devWwelisa/icon.png" />
        <preference name="Orientation" value="portrait" />
    </platform>
    <preference name="Fullscreen" value="true" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#448AFF" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="devWwelisa/splash.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#0a2a44" />
</widget>
